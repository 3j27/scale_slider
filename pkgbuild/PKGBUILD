pkgname=scale-slider
pkgver=0.1.0
pkgrel=1
pkgdesc='Adjust Omarchy display scaling with a live slider'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'hyprland')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() {
  cd "$startdir/.."
  ./bin/build
}
package() {
  cd "$startdir/.."
  install -Dm755 build/scale-slider "$pkgdir/usr/bin/scale-slider"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/scale-slider.desktop "$pkgdir/usr/share/applications/scale-slider.desktop"
  install -Dm644 pkgbuild/scale-slider.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/scale-slider.svg"
}
